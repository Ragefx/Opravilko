<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the app find the phone's voice input (Android 11+ hides other apps otherwise). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Dropbox sign-in returns here: the website's callback page forwards
                 the authorization code to opravilko://oauth?code=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opravilko" android:host="oauth" />
            </intent-filter>

            <!-- Taps on the home-screen widget: open a task/view, or quick add. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="opravilko" android:host="open" />
                <data android:scheme="opravilko" android:host="add" />
            </intent-filter>

            <!-- "Share to Opravilko" from other apps: text and links, photos. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- Long-press shortcuts on the app icon. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- Home-screen task list widget. -->
        <receiver
            android:name=".widget.TaskWidgetProvider"
            android:label="@string/widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/task_widget_info" />
        </receiver>

        <service
            android:name=".widget.TaskWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <service
            android:name=".widget.WidgetSyncJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <activity
            android:name=".widget.WidgetActionActivity"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:exported="false" />

        <!-- The widget's Add task sheet, over the home screen. -->
        <activity
            android:name=".widget.QuickAddActivity"
            android:theme="@style/WidgetQuickAddTheme"
            android:excludeFromRecents="true"
            android:taskAffinity="com.opravilko.app.quickadd"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible"
            android:exported="false" />

        <!-- A shopping item tapped in the widget: edited over the home screen. -->
        <activity
            android:name=".widget.ShopItemActivity"
            android:theme="@style/WidgetQuickAddTheme"
            android:excludeFromRecents="true"
            android:taskAffinity="com.opravilko.app.shopitem"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:exported="false" />

        <!-- A task tapped in the widget: opened over the home screen. -->
        <activity
            android:name=".widget.TaskItemActivity"
            android:theme="@style/WidgetQuickAddTheme"
            android:excludeFromRecents="true"
            android:taskAffinity="com.opravilko.app.taskitem"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:exported="false" />

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:theme="@style/WidgetConfigTheme"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Arrival reminders: woken on arriving at a watched place. After a
             restart or an app update: the places watched and task reminders set again. -->
        <receiver
            android:name=".places.GeofenceReceiver"
            android:exported="false" />

        <receiver
            android:name=".places.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Task reminders: going off, and their Done / Snooze buttons. -->
        <receiver
            android:name=".widget.ReminderReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Arrival reminders ("Remind me when I arrive" on a task's location). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Task reminders on time to the minute (a reminder app may use exact alarms). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
</manifest>
