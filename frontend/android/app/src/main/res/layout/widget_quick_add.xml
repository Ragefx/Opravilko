<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's Add task / shopping card, floating over the home screen above
     the keyboard, in the app's look: the name (and a description line for
     tasks), what's set as small tokens (tap to change, × to clear), a line,
     then where it goes on the left, one row of same-size icons, and the round
     mic / send button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qa_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#52000000">

    <LinearLayout
        android:id="@+id/qa_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/qa_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/qa_sheet_bg"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/qa_added"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:textColor="@color/widget_due_today"
                android:textSize="12sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/qa_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="@string/qa_task_hint"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:minHeight="36dp"
                android:paddingEnd="6dp"
                android:textColor="@color/widget_text"
                android:textColorHint="@color/widget_text_muted"
                android:textSize="18sp" />

            <!-- Shopping list: what the typed line will add ("🥛 Mleko 2×"). -->
            <TextView
                android:id="@+id/qa_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/qa_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/qa_description_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="28dp"
                android:paddingEnd="6dp"
                android:textColor="@color/widget_text_secondary"
                android:textColorHint="@color/widget_text_muted"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:id="@+id/qa_tokens_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fadingEdgeLength="20dp"
                android:requiresFadingEdge="horizontal"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/qa_tokens"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="6dp"
                android:background="@color/widget_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/qa_where"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/qa_chip_bg"
                    android:drawablePadding="6dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:maxWidth="140dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="13sp" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fadingEdgeLength="20dp"
                    android:requiresFadingEdge="horizontal"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/qa_tools"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <ImageButton
                    android:id="@+id/qa_send"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/qa_send_bg"
                    android:contentDescription="@string/widget_add_by_voice"
                    android:elevation="2dp"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qa_mic" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
