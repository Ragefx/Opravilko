rules_version = '2';

// Who can read and change what in Opravilko's Firestore database.
// Paste this into Firebase console -> Firestore Database -> Rules (or deploy
// with `firebase deploy --only firestore:rules`).
//
// - A project is visible to the people in its `members` list; its sections
//   and tasks follow the project.
// - Only a project's owner changes who's in it; anyone else can only leave.
// - A task can also be shared on its own with your partner (sharedWith).
// - Labels, filters, calendars and completion history under users/{uid}
//   are private to that person.
// - userEmails/{email} lets someone who knows your exact email address find
//   you to share a project with; nobody can list them.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return request.auth.uid;
    }
    function projectPath(pid) {
      return /databases/$(database)/documents/projects/$(pid);
    }
    function isMember(pid) {
      return signedIn() && exists(projectPath(pid)) && me() in get(projectPath(pid)).data.members;
    }
    // For writes: membership as it will be once this write (or batch) is done,
    // so a project and its tasks can be created together.
    function isMemberAfter(pid) {
      return signedIn() && existsAfter(projectPath(pid)) && me() in getAfter(projectPath(pid)).data.members;
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
      match /{rest=**} {
        allow read, write: if signedIn() && me() == uid;
      }
    }

    match /userEmails/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.uid == me()
        && email == request.auth.token.email.lower();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    match /projects/{pid} {
      // Reading a project that doesn't exist (yet) is allowed, so the app can
      // check whether your Inbox needs creating; it reveals nothing.
      allow read: if signedIn() && (resource == null || me() in resource.data.members);
      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.members == [me()]
        // Only you can create "inbox_<your id>".
        && (!pid.matches('inbox_.*') || pid == 'inbox_' + me());
      allow update: if signedIn() && me() in resource.data.members && (
        // The owner can change anything except who owns it.
        (me() == resource.data.ownerId && request.resource.data.ownerId == me() && me() in request.resource.data.members)
        // Other members edit the project but not its membership...
        || (onlyChanges(['name', 'color', 'order', 'isFavorite', 'parentId', 'viewStyle', 'meals', 'bought', 'stores']))
        // ...except to leave it.
        || (onlyChanges(['members', 'memberProfiles'])
            && request.resource.data.members == resource.data.members.removeAll([me()]))
      );
      allow delete: if signedIn() && me() == resource.data.ownerId;
    }

    match /sections/{sid} {
      allow read, delete: if isMember(resource.data.projectId);
      allow create: if isMemberAfter(request.resource.data.projectId);
      allow update: if isMember(resource.data.projectId) && isMemberAfter(request.resource.data.projectId);
    }

    // A task shared on its own ("Midva"): the people in its sharedWith list
    // can read, edit, complete and delete it, but not move it out of its
    // creator's project or change who it's shared with.
    function sharedWithMe(data) {
      return signedIn() && me() in data.get('sharedWith', []);
    }

    match /tasks/{tid} {
      allow read, delete: if isMember(resource.data.projectId) || sharedWithMe(resource.data);
      allow create: if isMemberAfter(request.resource.data.projectId);
      allow update: if (isMember(resource.data.projectId) && isMemberAfter(request.resource.data.projectId))
        || (sharedWithMe(resource.data)
            && onlyChanges(['content', 'description', 'priority', 'due', 'labels', 'completed', 'completedAt',
                            'completedBy', 'comments', 'reminderMinutes', 'updatedAt', 'order', 'archived',
                            'attachments', 'location']));
    }

    // ---- attachments: file contents stored in chunks under attachments/{id} ----
    // You can read and add files on any task you can see; the space they use
    // is counted in meta/storage, which can't go over the attachments budget
    // (700 MB), so the free 1 GB database never fills up.
    function canAccessTask(tid) {
      return exists(/databases/$(database)/documents/tasks/$(tid))
        && (isMember(get(/databases/$(database)/documents/tasks/$(tid)).data.projectId)
            || sharedWithMe(get(/databases/$(database)/documents/tasks/$(tid)).data));
    }
    function taskGone(tid) {
      return !exists(/databases/$(database)/documents/tasks/$(tid));
    }

    match /attachments/{aid} {
      allow read: if signedIn() && canAccessTask(resource.data.taskId);
      allow create: if signedIn()
        && request.resource.data.ownerUid == me()
        && request.resource.data.size <= 10485760
        && canAccessTask(request.resource.data.taskId);
      allow update: if signedIn() && resource.data.ownerUid == me() && onlyChanges(['status']);
      allow delete: if signedIn()
        && (resource.data.ownerUid == me() || canAccessTask(resource.data.taskId) || taskGone(resource.data.taskId));

      match /chunks/{cid} {
        function att() {
          return get(/databases/$(database)/documents/attachments/$(aid)).data;
        }
        allow read: if signedIn() && canAccessTask(att().taskId);
        allow create: if signedIn() && att().ownerUid == me() && request.resource.data.data.size() <= 950000;
        allow delete: if signedIn()
          && (att().ownerUid == me() || canAccessTask(att().taskId) || taskGone(att().taskId));
      }
    }

    match /meta/storage {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['bytes'])
        && request.resource.data.bytes is int
        && (request.resource.data.bytes <= 734003200
            || (resource != null && request.resource.data.bytes < resource.data.bytes));
    }
  }
}
