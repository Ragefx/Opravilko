<?xml version="1.0" encoding="utf-8"?>
<!-- The widget as a month, in the website's calendar style: the header, the month
     with ‹ ›, the weekday row, then the weeks in a grid with thin lines
     (added by CalendarWidget, one widget_cal_week per week). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">

    <include layout="@layout/widget_header" />

    <!-- The month on the left; ‹ › on the right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/cal_month"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Two big round buttons, 40dp wide, easy to hit. -->
        <ImageView
            android:id="@+id/cal_prev"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_cal_nav_bg"
            android:contentDescription="@string/widget_cal_prev"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_w_prev" />

        <ImageView
            android:id="@+id/cal_next"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_cal_nav_bg"
            android:contentDescription="@string/widget_cal_next"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_w_next" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="8dp"
        android:background="@color/widget_cal_line"
        android:orientation="vertical"
        android:padding="0.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView style="@style/WidgetCalWeekday" android:text="Mon" />
            <TextView style="@style/WidgetCalWeekday" android:text="Tue" />
            <TextView style="@style/WidgetCalWeekday" android:text="Wed" />
            <TextView style="@style/WidgetCalWeekday" android:text="Thu" />
            <TextView style="@style/WidgetCalWeekday" android:text="Fri" />
            <TextView style="@style/WidgetCalWeekday" android:text="Sat" />
            <TextView style="@style/WidgetCalWeekday" android:text="Sun" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cal_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
