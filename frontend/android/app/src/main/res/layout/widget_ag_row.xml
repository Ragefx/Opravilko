<?xml version="1.0" encoding="utf-8"?>
<!-- A task in the list: the ring to tick it off, its name, its time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ag_row"
    android:layout_width="match_parent"
    android:layout_height="26dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ag_check"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="@string/widget_complete_task"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:src="@drawable/widget_check_1" />

    <TextView
        android:id="@+id/ag_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/ag_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
