<?xml version="1.0" encoding="utf-8"?>
<!-- A task in the widget: the tick circle, the name, and a line with its
     date / repeat / notes on the left and its project on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <!-- Generous padding: the circle is small but the tap target isn't. -->
    <ImageView
        android:id="@+id/row_check"
        android:layout_width="52dp"
        android:layout_height="44dp"
        android:contentDescription="@string/widget_complete_task"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:paddingEnd="17dp"
        android:paddingBottom="13dp"
        android:src="@drawable/widget_check_1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/row_due_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_calendar" />

            <TextView
                android:id="@+id/row_due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:maxLines="1"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/row_repeat"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_repeat" />

            <ImageView
                android:id="@+id/row_notes"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_notes" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/row_project"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="130dp"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/row_project_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_inbox" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
