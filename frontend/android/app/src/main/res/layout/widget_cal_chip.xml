<?xml version="1.0" encoding="utf-8"?>
<!-- A task in a day: a blue chip (red when overdue). Small fixed-size text (dp,
     not sp), so a large phone font doesn't cut the names to two letters. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cal_chip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="1.5dp"
    android:background="@drawable/widget_cal_task_bg"
    android:singleLine="true"
    android:ellipsize="none"
    android:paddingStart="2dp"
    android:paddingTop="1dp"
    android:paddingEnd="1dp"
    android:paddingBottom="1dp"
    android:textColor="@color/widget_cal_task_text"
    android:fontFamily="@font/google_sans_medium"
    android:textSize="8.5dp" />
