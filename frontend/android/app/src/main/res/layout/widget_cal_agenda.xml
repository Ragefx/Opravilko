<?xml version="1.0" encoding="utf-8"?>
<!-- The widget as a small month with the tasks under it: the header, the month
     with ‹ ›, weekday letters, the weeks (widget_ag_week, with dots for
     tasks and a band for trips), then the chosen day's and the next days' tasks. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">

    <include layout="@layout/widget_header" />

    <!-- The month on the left; ‹ › on the right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/cal_month"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Two big round buttons, 40dp wide, easy to hit. -->
        <ImageView
            android:id="@+id/cal_prev"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_cal_nav_bg"
            android:contentDescription="@string/widget_cal_prev"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_w_prev" />

        <ImageView
            android:id="@+id/cal_next"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_cal_nav_bg"
            android:contentDescription="@string/widget_cal_next"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_w_next" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView style="@style/WidgetAgWeekday" android:text="M" />
        <TextView style="@style/WidgetAgWeekday" android:text="T" />
        <TextView style="@style/WidgetAgWeekday" android:text="W" />
        <TextView style="@style/WidgetAgWeekday" android:text="T" />
        <TextView style="@style/WidgetAgWeekday" android:text="F" />
        <TextView style="@style/WidgetAgWeekday" android:text="S" />
        <TextView style="@style/WidgetAgWeekday" android:text="S" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ag_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <LinearLayout
        android:id="@+id/ag_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_cal_card_bg"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp" />
</LinearLayout>
