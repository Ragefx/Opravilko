# Dropbox app credentials (from https://www.dropbox.com/developers/apps)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Obtained once via GET /api/auth/dropbox/connect -> copy the refresh token shown at the callback
DROPBOX_REFRESH_TOKEN=
# Path inside your Dropbox (app folder) where the task data is stored
DROPBOX_DATA_PATH=/opravilko-data.json

# App-level password gate (leave empty to disable, e.g. for local dev)
APP_PASSWORD=
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
